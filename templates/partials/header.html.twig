<div class="header-wrapper" id="main-header">
    <header class="header">
        <div class="header__brand">
            <div class="header__brand-logo">
                <a href="{{ path('home') }}" title="Home page">
                    {{ iconRenderer('logo') }}
                </a>
            </div>
            <div class="header__brand-button">
                <button
                        class="header__hamburger"
                        id="js-hamburger"
                        type="button"
                        aria-controls="menuNav"
                        aria-expanded="false"
                        aria-label="Open menu"
                >
                    <span></span>
                </button>
            </div>
        </div>
        <nav class="header__nav" id="menuNav">
            <ul class="nav-menu nav-menu--main">
                <li class="nav-menu__entry">
                    <a class="nav-menu__link" href="{{ path('app_blog') }}">Blog</a>
                </li>
                <li class="nav-menu__entry">
                    <a class="nav-menu__link" href="{{ path('app_projects') }}">Projects</a>
                </li>
                <li class="nav-menu__entry">
                    <a class="nav-menu__link" href="{{ path('app_events') }}">Events</a>
                </li>
                <li class="nav-menu__entry">
                    <a class="nav-menu__link" href="https://shop.lakamark.com/" target="_blank">Shop</a>
                </li>
                <li class="nav-menu__entry">
                    <a class="nav-menu__link" href="{{ path('app_contact') }}">Contact</a>
                </li>
            </ul>

            <ul class="nav-menu nav-menu--actions">
                {% if app.user %}
                    <li class="nav-menu__entry nav-menu__entry--account">
                        <a class="nav-menu__link" href="{{ path('app_account') }}">
                            Hello {{ app.user.username }}
                        </a>
                    </li>
                    <li class="nav-menu__entry nav-menu__entry--logout">
                        <form method="post" action="{{ path('app_logout') }}">
                            <button type="submit" class="nav-menu__link">
                                Logout
                            </button>
                        </form>
                    </li>
                {% else %}
                    <li class="nav-menu__entry nav-menu__entry--login">
                        <a class="nav-menu__link" href="{{ path('app_login') }}">Login</a>
                    </li>
                    <li class="nav-menu__entry nav-menu__entry--signup">
                        <a class="nav-menu__link" href="{{ path('auth_register') }}">Signup</a>
                    </li>
                {% endif %}

                <li class="nav-menu__entry nav-menu__entry--theme">
                </li>
            </ul>
        </nav>
    </header>
</div>